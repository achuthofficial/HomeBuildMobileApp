# Copy to .env and fill in. Everything prefixed EXPO_PUBLIC_ is inlined into the
# app bundle and is therefore readable by anyone with the app — only put
# publishable keys here.

# Python backend (FastAPI). Use your machine's LAN IP for a physical device.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Firebase — Project settings > General > Your apps > Web app config
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Supabase — Project settings > API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
