# Server-side secrets. Never commit the real .env, and never ship these keys
# to the mobile app.

ENVIRONMENT=development
DEBUG=true

# Comma-free JSON list of allowed browser origins for the Expo web build.
# CORS_ORIGINS=["http://localhost:8081"]

# --- Firebase Admin ---------------------------------------------------------
FIREBASE_PROJECT_ID=
# Path to the service-account JSON downloaded from
# Project settings > Service accounts > Generate new private key
FIREBASE_CREDENTIALS_FILE=./serviceAccountKey.json
# ...or the JSON itself, on hosts that only support env vars:
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=
# Service-role key (Project settings > API). Bypasses row level security.
SUPABASE_SERVICE_ROLE_KEY=
